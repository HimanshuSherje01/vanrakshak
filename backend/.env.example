# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma separated list of allowed frontend origins (CORS)
CLIENT_ORIGIN=http://localhost:5173

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/tadoba_portal

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# ---- Seed (npm run seed) ----
SEED_ADMIN_NAME=Forest Officer
SEED_ADMIN_EMAIL=admin@tadoba.local
SEED_ADMIN_PASSWORD=ChangeMe@12345

# ---- Demonstration Mode ----
# Set to true for local evaluation (NEVER enable in production; disabled automatically if NODE_ENV=production)
DEMO_MODE=false

